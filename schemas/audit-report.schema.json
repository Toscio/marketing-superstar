{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Toscio/marketing-superstar/schemas/audit-report.schema.json",
  "title": "MarketingSuperstarAuditReport",
  "type": "object",
  "required": ["schemaVersion", "title", "generatedAt", "summary", "sites", "agentQueue"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "depth": { "enum": ["scan", "standard", "deep"] },
    "coverage": { "type": "array", "items": { "type": "string" } },
    "title": { "type": "string" },
    "eyebrow": { "type": "string" },
    "lede": { "type": "string" },
    "meta": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "method": { "type": "string" },
    "summary": { "type": "array", "items": { "type": "string" } },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["siteId", "name", "primaryUrl", "findings"],
        "properties": {
          "siteId": { "type": "string" },
          "name": { "type": "string" },
          "primaryUrl": { "type": "string" },
          "stagingUrl": { "type": "string" },
          "stats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["value", "label"],
              "properties": {
                "value": { "type": "string" },
                "label": { "type": "string" }
              }
            }
          },
          "alreadyDoneWell": { "type": "array", "items": { "type": "string" } },
          "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
        }
      }
    },
    "timeline": { "type": "array" },
    "appendix": { "type": "array" },
    "agentQueue": {
      "type": "array",
      "description": "Flattened actionable findings sorted P0→P2 for implementing agents",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "priority", "level", "category", "title", "effort", "what", "why", "fix"],
      "properties": {
        "id": { "type": "string" },
        "priority": { "type": "string" },
        "level": { "enum": ["P0", "P1", "P2"] },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "effort": { "type": "string" },
        "what": { "type": "string" },
        "why": { "type": "string" },
        "fix": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "relatedUrls": { "type": "array", "items": { "type": "string" } },
        "artifacts": { "type": "array" },
        "agentAction": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "target": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
